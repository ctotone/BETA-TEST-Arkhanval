<div class="arkhanval-sheet-shell">
  <nav class="arkhanval-sheet-tabs tabs" data-group="sheet" aria-label="{{localize "ARKHANVAL.Sheet.Navigation"}}">
    <button type="button" class="arkhanval-sheet-tab {{tabs.character.cssClass}}" data-action="tab" data-group="sheet" data-tab="character">
      <i class="{{tabs.character.icon}}" aria-hidden="true"></i>
      <span>{{tabs.character.label}}</span>
    </button>
    <button type="button" class="arkhanval-sheet-tab {{tabs.equipment.cssClass}}" data-action="tab" data-group="sheet" data-tab="equipment">
      <i class="{{tabs.equipment.icon}}" aria-hidden="true"></i>
      <span>{{tabs.equipment.label}}</span>
    </button>
    <button type="button" class="arkhanval-sheet-tab {{tabs.spells.cssClass}}" data-action="tab" data-group="sheet" data-tab="spells">
      <i class="{{tabs.spells.icon}}" aria-hidden="true"></i>
      <span>{{tabs.spells.label}}</span>
    </button>
    <button type="button" class="arkhanval-sheet-tab {{tabs.progression.cssClass}}" data-action="tab" data-group="sheet" data-tab="progression">
      <i class="{{tabs.progression.icon}}" aria-hidden="true"></i>
      <span>{{tabs.progression.label}}</span>
    </button>
  </nav>

  <div class="arkhanval-sheet-scroll">
    <section class="tab {{tabs.character.cssClass}}" data-group="sheet" data-tab="character">
      <div class="arkhanval-sheet-page arkhanval-sheet-page-1 arkhanval-sheet-page-1--dynamic" aria-label="{{localize "ARKHANVAL.Sheet.Pages.Character"}}">
        <button type="button" class="arkhanval-advanced-lock" data-advanced-lock
                aria-label="Déverrouiller la fiche" title="Déverrouiller la fiche"
                {{#unless editable}}disabled{{/unless}}>
          <i class="fa-solid fa-lock" aria-hidden="true"></i>
        </button>

        <img class="arkhanval-sheet-logo arkhanval-sheet-logo--page1"
             src="systems/arkhanval/assets/sheets/common/logo_arkhanval.webp"
             alt=""
             aria-hidden="true">
        <div class="arkhanval-page1-content">
          <section class="arkhanval-page1-identity" aria-label="Identité">
            <div class="arkhanval-identity-column arkhanval-identity-column--left">
              <label class="arkhanval-identity-block">
                <span class="arkhanval-section-label">{{localize "ARKHANVAL.Fields.Name"}}</span>
                <span class="arkhanval-paper-input">
                  <input class="arkhanval-overlay arkhanval-identity-field arkhanval-identity-field--name"
                         type="text"
                         data-actor-name
                         value="{{actor.name}}"
                         aria-label="{{localize "ARKHANVAL.Fields.Name"}}"
                         {{#unless editable}}disabled{{/unless}}>
                </span>
              </label>

              <label class="arkhanval-identity-block arkhanval-identity-block--people">
                <span class="arkhanval-section-label">{{localize "ARKHANVAL.Fields.People"}}</span>
                <span class="arkhanval-paper-input">
                  <input class="arkhanval-overlay arkhanval-identity-field arkhanval-identity-field--people"
                         type="text"
                         value="{{identity.people}}"
                         data-people-field
                         aria-label="{{localize "ARKHANVAL.Fields.People"}}"
                         {{#unless editable}}disabled{{/unless}}>
                </span>
              </label>
            </div>
<div class="arkhanval-portrait-frame">
              <img class="arkhanval-portrait"
                   src="{{actor.img}}"
                   alt="Portrait de {{actor.name}}"
                   {{#if editable}}data-action="editImage" data-edit="img" title="Modifier le portrait"{{/if}}>
            </div>

            <label class="arkhanval-identity-technique" aria-label="{{localize "ARKHANVAL.Fields.CombatTechniqueHelp"}}">
              <span class="arkhanval-section-label arkhanval-section-label--combat-technique">{{localize "ARKHANVAL.Fields.CombatTechnique"}}</span>
              <span class="arkhanval-paper-input arkhanval-paper-input--combat-technique">
                <select class="arkhanval-combat-technique-select"
                        name="{{identity.combatTechnique.name}}"
                        data-combat-technique
                        aria-label="{{localize "ARKHANVAL.Fields.CombatTechnique"}}"
                        {{#unless editable}}disabled{{/unless}}>
                  {{#each identity.combatTechnique.options as |option|}}
                    <option value="{{option.id}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                  {{/each}}
                </select>
              </span>
            </label>

            <div class="arkhanval-identity-column arkhanval-identity-column--right">
              <div class="arkhanval-identity-block">
                <span class="arkhanval-section-label">{{localize "ARKHANVAL.Fields.MainArchetypes"}}</span>
                <span class="arkhanval-paper-input arkhanval-paper-input--double">
                  <span class="arkhanval-primary-archetypes" aria-label="{{localize "ARKHANVAL.Fields.MainArchetypes"}}">
                    {{#each identity.primaryArchetypeSlots as |slot|}}
                      <select class="arkhanval-archetype-select"
                              data-primary-archetype-slot="{{slot.index}}"
                              aria-label="{{localize "ARKHANVAL.Fields.MainArchetypes"}} {{slot.index}}"
                              {{#unless ../editable}}disabled{{/unless}}>
                        <option value=""></option>
                        {{#each slot.options as |option|}}
                          <option value="{{option.id}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                        {{/each}}
                      </select>
                    {{/each}}
                  </span>
                </span>
              </div>

              <label class="arkhanval-identity-block arkhanval-identity-block--origin">
                <span class="arkhanval-section-label">{{localize "ARKHANVAL.Fields.Origin"}}</span>
                <span class="arkhanval-paper-input">
                  <input class="arkhanval-overlay arkhanval-identity-field arkhanval-identity-field--origin"
                         type="text"
                         name="{{identity.origin.name}}"
                         value="{{identity.origin.value}}"
                         aria-label="{{localize "ARKHANVAL.Fields.Origin"}}"
                         {{#unless editable}}disabled{{/unless}}>
                </span>
              </label>
            </div>
          </section>

          <section class="arkhanval-page1-main" aria-label="Archétypes, Arks et blessures">
            <div class="arkhanval-archetype-column arkhanval-archetype-column--left">
              {{#each archetypeColumns.left as |archetype|}}
                <article class="arkhanval-archetype-card arkhanval-archetype-card--{{archetype.side}} arkhanval-archetype-card--{{archetype.id}}" data-archetype-id="{{archetype.id}}" style="--arkhanval-skill-row-count: {{archetype.skillRowCount}};">
                  <header class="arkhanval-archetype-card__header">
                    <div class="arkhanval-archetype-card__identity">
                      <img class="arkhanval-archetype-card__icon"
                           src="systems/arkhanval/assets/icones/archetype/{{archetype.id}}.webp"
                           alt=""
                           aria-hidden="true">
                      <img class="arkhanval-archetype-card__title"
                           src="systems/arkhanval/assets/sheets/page1/titre_{{archetype.id}}.webp"
                           alt="{{archetype.label}}">
                      <span class="arkhanval-die-index" aria-label="Repère {{archetype.displayIndex}}">
                        <svg class="arkhanval-die-index__shape" viewBox="0 0 22 22" aria-hidden="true" focusable="false">
                          <polygon points="11,1 21,8.2 17.2,20.5 4.8,20.5 1,8.2"></polygon>
                        </svg>
                        <span class="arkhanval-die-index__value">{{archetype.displayIndex}}</span>
                      </span>
                    </div>
  
                    <label class="arkhanval-archetype-xp">
                      <span>XP</span>
                      <input class="arkhanval-overlay arkhanval-number-field arkhanval-archetype-rank"
                             type="number"
                             name="{{archetype.xp.name}}"
                             value="{{archetype.xp.value}}"
                             aria-label="{{archetype.label}} - XP"
                             title="{{archetype.label}} - XP"
                             {{#unless ../editable}}disabled{{/unless}}>
                    </label>
                  </header>
  
                  <div class="arkhanval-skill-columns" aria-hidden="true">
                    <span></span><span>Rang</span><span>XP</span>
                  </div>
  
                  <div class="arkhanval-archetype-skills">
                    {{#each archetype.skills as |skill|}}
                      <div class="arkhanval-skill-row{{#if skill.isCustom}} arkhanval-skill-row--custom{{/if}}" data-skill-row-index="{{skill.index}}">
                        <button class="arkhanval-skill-label{{#if skill.labelSize}} arkhanval-skill-label--{{skill.labelSize}}{{/if}} arkhanval-skill-action"
                                type="button"
                                data-skill-action
                                data-skill-archetype="{{../id}}"
                                data-skill-identifier="{{skill.identifier}}"
                                data-skill-custom="{{skill.isCustom}}"
                                {{#if skill.itemId}}data-item-id="{{skill.itemId}}"{{/if}}
                                aria-label="{{skill.itemName}} — {{#if skill.itemId}}{{localize "ARKHANVAL.Resolution.SkillClickHint"}}{{else}}{{localize "ARKHANVAL.Resolution.SkillClickHintRollOnly"}}{{/if}}">{{skill.itemName}}</button>
                        <span class="arkhanval-skill-tooltip" role="tooltip" aria-hidden="true">
                          <strong class="arkhanval-skill-tooltip__title">{{skill.itemName}}</strong>
                          <span class="arkhanval-skill-tooltip__action">
                            <span class="arkhanval-skill-tooltip__gesture"><span class="arkhanval-skill-tooltip__mouse" aria-hidden="true"><i class="fa-solid fa-computer-mouse"></i></span>Clic</span>
                            <span class="arkhanval-skill-tooltip__arrow" aria-hidden="true">→</span>
                            <span class="arkhanval-skill-tooltip__result">Préparer le jet</span>
                          </span>
                          <span class="arkhanval-skill-tooltip__action{{#unless skill.itemId}} arkhanval-skill-tooltip__action--unavailable{{/unless}}" data-skill-tooltip-detail {{#unless skill.itemId}}hidden{{/unless}}>
                            <span class="arkhanval-skill-tooltip__gesture"><kbd>Maj</kbd><span aria-hidden="true">+</span><span class="arkhanval-skill-tooltip__mouse" aria-hidden="true"><i class="fa-solid fa-computer-mouse"></i></span>Clic</span>
                            <span class="arkhanval-skill-tooltip__arrow" aria-hidden="true">→</span>
                            <span class="arkhanval-skill-tooltip__result">Ouvrir la fiche</span>
                          </span>
                        </span>
  
                        <input class="arkhanval-overlay arkhanval-number-field arkhanval-skill-value"
                               type="number"
                               value="{{skill.rank}}"
                               data-skill-field="rank"
                               data-skill-archetype="{{../id}}"
                               data-skill-identifier="{{skill.identifier}}"
                               data-skill-name="{{skill.itemName}}"
                               data-skill-custom="{{skill.isCustom}}"
                               {{#if skill.itemId}}data-item-id="{{skill.itemId}}"{{/if}}
                               aria-label="{{archetype.label}} - compétence {{skill.index}} - valeur"
                               title="{{archetype.label}} - compétence {{skill.index}} - valeur"
                               {{#unless ../../editable}}disabled{{/unless}}>
  
                        <input class="arkhanval-overlay arkhanval-number-field arkhanval-skill-xp"
                               type="number"
                               value="{{skill.xp}}"
                               data-skill-field="xp"
                               data-skill-archetype="{{../id}}"
                               data-skill-identifier="{{skill.identifier}}"
                               data-skill-name="{{skill.itemName}}"
                               data-skill-custom="{{skill.isCustom}}"
                               {{#if skill.itemId}}data-item-id="{{skill.itemId}}"{{/if}}
                               aria-label="{{archetype.label}} - compétence {{skill.index}} - XP"
                               title="{{archetype.label}} - compétence {{skill.index}} - XP"
                               {{#unless ../../editable}}disabled{{/unless}}>
                      </div>
                    {{/each}}
                  </div>
                </article>
              {{/each}}
            </div>

            <aside class="arkhanval-page1-center">
              <section class="arkhanval-arks-panel" aria-label="Arks">
                {{#each arkTracks as |track|}}
                  <article class="arkhanval-ark-unit arkhanval-ark-unit--{{track.id}}">
                    <div class="arkhanval-ark-track arkhanval-ark-track--{{track.id}}">
                      {{#each track.marks as |mark|}}
                        <label class="arkhanval-ark-mark arkhanval-ark-mark--{{mark.index}}" title="{{track.id}} {{mark.index}}">
                          <input type="checkbox"
                                 data-ark="{{track.id}}"
                                 data-ark-circle="{{mark.index}}"
                                 {{#if mark.checked}}checked{{/if}}
                                 {{#unless ../../editable}}disabled{{/unless}}>
                          <span></span>
                        </label>
                      {{/each}}

                      <button type="button"
                              class="arkhanval-ark-roll-button arkhanval-ark-roll-button--{{track.id}}"
                              data-ark-action="{{track.id}}"
                              aria-label="{{#if track.hasTable}}{{track.label}} — choisir une action{{else}}{{track.label}} — lancer les dés{{/if}}"
                              title="{{track.label}} · {{#if track.hasTable}}Clic : choisir une action{{else}}Clic : jet{{/if}}">
                        <img src="systems/arkhanval/assets/icones/ark/{{track.id}}.webp" alt="" aria-hidden="true">
                      </button>
                    </div>

                    <div class="arkhanval-ark-unit__footer">
                      <span class="arkhanval-die-index arkhanval-die-index--ark" aria-label="Repère {{track.displayIndex}}">
                        <svg class="arkhanval-die-index__shape" viewBox="0 0 22 22" aria-hidden="true" focusable="false">
                          <polygon points="11,1 21,8.2 17.2,20.5 4.8,20.5 1,8.2"></polygon>
                        </svg>
                        <span class="arkhanval-die-index__value">{{track.displayIndex}}</span>
                      </span>
                      <img class="arkhanval-ark-unit__title-image" src="systems/arkhanval/assets/sheets/page1/titre_{{track.id}}.webp" alt="{{track.label}}">
                      <input class="arkhanval-overlay arkhanval-number-field arkhanval-ark-value arkhanval-ark-value--{{track.id}}"
                             type="number"
                             data-ark-rank="{{track.id}}"
                             name="{{track.rankName}}"
                             value="{{track.rankValue}}"
                             aria-label="{{track.label}}"
                             title="{{track.label}}"
                             {{#unless ../editable}}disabled{{/unless}}>
                    </div>
                  </article>
                {{/each}}
              </section>

              <section class="arkhanval-wounds-panel" aria-label="{{localize "ARKHANVAL.Wounds.Title"}}">
                <h3 class="arkhanval-wounds-panel__title">{{localize "ARKHANVAL.Wounds.Title"}}</h3>

                {{#each woundTracks as |track|}}
                  <div class="arkhanval-wounds-panel__group arkhanval-wounds-panel__group--{{track.id}}">
                    <div class="arkhanval-wounds-panel__range">{{localize track.rangeKey}}</div>
                    <div class="arkhanval-wounds-panel__label">{{localize track.labelKey}}</div>
                    <div class="arkhanval-wound-track arkhanval-wound-track--{{track.id}}">
                      {{#each track.marks as |mark|}}
                        <label class="arkhanval-wound-mark" title="{{track.countCurrent}} / {{track.capacity}}" {{#unless mark.available}}hidden{{/unless}}>
                          <input type="checkbox"
                                 data-wound-severity="{{track.id}}"
                                 data-wound-mark="{{mark.index}}"
                                 {{#if mark.itemId}}data-wound-item-id="{{mark.itemId}}"{{/if}}
                                 title="{{#if mark.itemId}}Maj+Clic : ouvrir la blessure{{else}}Ajouter une blessure{{/if}}"
                                 {{#if mark.checked}}checked{{/if}}
                                 {{#unless ../../editable}}disabled{{/unless}}>
                          <span></span>
                        </label>
                      {{/each}}
                    </div>
                  </div>
                {{/each}}

                <div class="arkhanval-wounds-panel__stats">
                  <label>
                    <span>{{localize "ARKHANVAL.Fields.Armor"}}</span>
                    <input class="arkhanval-overlay arkhanval-number-field arkhanval-wound-field arkhanval-wound-field--armor"
                           type="text"
                           value="{{wounds.armorDisplay}}"
                           data-active-protection
                           title="{{#if wounds.armorModifier}}Protection portée {{wounds.armor}}, modificateur {{wounds.armorModifier}}, protection effective {{wounds.armorEffective}}{{else}}Protection portée {{wounds.armor}}{{/if}}"
                           aria-label="{{localize "ARKHANVAL.Fields.Armor"}}"
                           readonly>
                  </label>
                  <label>
                    <span>{{localize "ARKHANVAL.Fields.FDPenalty"}}</span>
                    <input class="arkhanval-overlay arkhanval-number-field arkhanval-wound-field arkhanval-wound-field--fd-penalty"
                           type="number"
                           value="{{wounds.fdPenalty}}"
                           aria-label="{{localize "ARKHANVAL.Fields.FDPenalty"}}"
                           readonly>
                  </label>
                </div>
              </section>

              <section class="arkhanval-states-panel" aria-label="{{localize "ARKHANVAL.States.Title"}}">
                <div class="arkhanval-states-panel__vanilla" aria-label="États courants">
                  {{#each states as |state|}}
                    <label class="arkhanval-state-toggle">
                      <input class="arkhanval-state-toggle__native"
                             type="checkbox"
                             data-actor-state="{{state.id}}"
                             {{#if state.checked}}checked{{/if}}
                             {{#unless ../editable}}disabled{{/unless}}>
                      <span class="arkhanval-state-toggle__check" aria-hidden="true"></span>
                      <span class="arkhanval-state-toggle__label">{{state.label}}</span>
                    </label>
                  {{/each}}
                </div>
                <div class="arkhanval-states-panel__divider" aria-hidden="true"></div>
                <div class="arkhanval-states-panel__custom" data-state-items-zone aria-label="Autres états">
                  {{#each stateItems as |item|}}
                    <button type="button"
                            class="arkhanval-state-item"
                            data-item-open
                            data-item-id="{{item.id}}"
                            title="{{item.name}}">
                      {{item.name}}
                    </button>
                  {{/each}}
                </div>
                {{#if canManageStates}}
                  <span class="arkhanval-states-panel__title arkhanval-states-panel__title--debug"
                        data-state-manager-open
                        role="button"
                        tabindex="0"
                        title="Afficher et gérer tous les états appliqués"
                        aria-label="Afficher et gérer tous les états appliqués">
                    {{localize "ARKHANVAL.States.Title"}}
                  </span>
                {{else}}
                  <span class="arkhanval-states-panel__title">{{localize "ARKHANVAL.States.Title"}}</span>
                {{/if}}
              </section>
            </aside>
            <div class="arkhanval-archetype-column arkhanval-archetype-column--right">
              {{#each archetypeColumns.right as |archetype|}}
                <article class="arkhanval-archetype-card arkhanval-archetype-card--{{archetype.side}} arkhanval-archetype-card--{{archetype.id}}" data-archetype-id="{{archetype.id}}" style="--arkhanval-skill-row-count: {{archetype.skillRowCount}};">
                  <header class="arkhanval-archetype-card__header">
                    <div class="arkhanval-archetype-card__identity">
                      <img class="arkhanval-archetype-card__icon"
                           src="systems/arkhanval/assets/icones/archetype/{{archetype.id}}.webp"
                           alt=""
                           aria-hidden="true">
                      <img class="arkhanval-archetype-card__title"
                           src="systems/arkhanval/assets/sheets/page1/titre_{{archetype.id}}.webp"
                           alt="{{archetype.label}}">
                      <span class="arkhanval-die-index" aria-label="Repère {{archetype.displayIndex}}">
                        <svg class="arkhanval-die-index__shape" viewBox="0 0 22 22" aria-hidden="true" focusable="false">
                          <polygon points="11,1 21,8.2 17.2,20.5 4.8,20.5 1,8.2"></polygon>
                        </svg>
                        <span class="arkhanval-die-index__value">{{archetype.displayIndex}}</span>
                      </span>
                    </div>
  
                    <label class="arkhanval-archetype-xp">
                      <span>XP</span>
                      <input class="arkhanval-overlay arkhanval-number-field arkhanval-archetype-rank"
                             type="number"
                             name="{{archetype.xp.name}}"
                             value="{{archetype.xp.value}}"
                             aria-label="{{archetype.label}} - XP"
                             title="{{archetype.label}} - XP"
                             {{#unless ../editable}}disabled{{/unless}}>
                    </label>
                  </header>
  
                  <div class="arkhanval-skill-columns" aria-hidden="true">
                    <span></span><span>Rang</span><span>XP</span>
                  </div>
  
                  <div class="arkhanval-archetype-skills">
                    {{#each archetype.skills as |skill|}}
                      <div class="arkhanval-skill-row{{#if skill.isCustom}} arkhanval-skill-row--custom{{/if}}" data-skill-row-index="{{skill.index}}">
                        <button class="arkhanval-skill-label{{#if skill.labelSize}} arkhanval-skill-label--{{skill.labelSize}}{{/if}} arkhanval-skill-action"
                                type="button"
                                data-skill-action
                                data-skill-archetype="{{../id}}"
                                data-skill-identifier="{{skill.identifier}}"
                                data-skill-custom="{{skill.isCustom}}"
                                {{#if skill.itemId}}data-item-id="{{skill.itemId}}"{{/if}}
                                aria-label="{{skill.itemName}} — {{#if skill.itemId}}{{localize "ARKHANVAL.Resolution.SkillClickHint"}}{{else}}{{localize "ARKHANVAL.Resolution.SkillClickHintRollOnly"}}{{/if}}">{{skill.itemName}}</button>
                        <span class="arkhanval-skill-tooltip" role="tooltip" aria-hidden="true">
                          <strong class="arkhanval-skill-tooltip__title">{{skill.itemName}}</strong>
                          <span class="arkhanval-skill-tooltip__action">
                            <span class="arkhanval-skill-tooltip__gesture"><span class="arkhanval-skill-tooltip__mouse" aria-hidden="true"><i class="fa-solid fa-computer-mouse"></i></span>Clic</span>
                            <span class="arkhanval-skill-tooltip__arrow" aria-hidden="true">→</span>
                            <span class="arkhanval-skill-tooltip__result">Préparer le jet</span>
                          </span>
                          <span class="arkhanval-skill-tooltip__action{{#unless skill.itemId}} arkhanval-skill-tooltip__action--unavailable{{/unless}}" data-skill-tooltip-detail {{#unless skill.itemId}}hidden{{/unless}}>
                            <span class="arkhanval-skill-tooltip__gesture"><kbd>Maj</kbd><span aria-hidden="true">+</span><span class="arkhanval-skill-tooltip__mouse" aria-hidden="true"><i class="fa-solid fa-computer-mouse"></i></span>Clic</span>
                            <span class="arkhanval-skill-tooltip__arrow" aria-hidden="true">→</span>
                            <span class="arkhanval-skill-tooltip__result">Ouvrir la fiche</span>
                          </span>
                        </span>
  
                        <input class="arkhanval-overlay arkhanval-number-field arkhanval-skill-value"
                               type="number"
                               value="{{skill.rank}}"
                               data-skill-field="rank"
                               data-skill-archetype="{{../id}}"
                               data-skill-identifier="{{skill.identifier}}"
                               data-skill-name="{{skill.itemName}}"
                               data-skill-custom="{{skill.isCustom}}"
                               {{#if skill.itemId}}data-item-id="{{skill.itemId}}"{{/if}}
                               aria-label="{{archetype.label}} - compétence {{skill.index}} - valeur"
                               title="{{archetype.label}} - compétence {{skill.index}} - valeur"
                               {{#unless ../../editable}}disabled{{/unless}}>
  
                        <input class="arkhanval-overlay arkhanval-number-field arkhanval-skill-xp"
                               type="number"
                               value="{{skill.xp}}"
                               data-skill-field="xp"
                               data-skill-archetype="{{../id}}"
                               data-skill-identifier="{{skill.identifier}}"
                               data-skill-name="{{skill.itemName}}"
                               data-skill-custom="{{skill.isCustom}}"
                               {{#if skill.itemId}}data-item-id="{{skill.itemId}}"{{/if}}
                               aria-label="{{archetype.label}} - compétence {{skill.index}} - XP"
                               title="{{archetype.label}} - compétence {{skill.index}} - XP"
                               {{#unless ../../editable}}disabled{{/unless}}>
                      </div>
                    {{/each}}
                  </div>
                </article>
              {{/each}}
            </div>
          </section>

          <section class="arkhanval-specialties" aria-label="Spécialités">
            <section class="arkhanval-specialties-block arkhanval-specialties-block--left">
              <div class="arkhanval-specialties-heading arkhanval-specialties-heading--left">
                <span>{{specialties.left.heading}}</span>
                <small>(xp : 20 / 20 / 30)</small>
              </div>
              <div class="arkhanval-specialties-paper">
