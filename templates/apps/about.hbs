<div class="arkhanval-about__content">
  <header class="arkhanval-about__header">
    <img class="arkhanval-about__logo" src="systems/arkhanval/assets/sheets/common/logo_arkhanval.webp" alt="" />
    <h2>{{systemName}}</h2>
    {{#if systemVersion}}
      <p class="arkhanval-about__version">{{localize "ARKHANVAL.About.Version"}} {{systemVersion}}</p>
    {{/if}}
  </header>

  <p class="arkhanval-about__description">{{localize "ARKHANVAL.About.Description"}}</p>

  <section class="arkhanval-about__credits" aria-label="{{localize "ARKHANVAL.About.CreditsTitle"}}">
    <h3>{{localize "ARKHANVAL.About.CreditsTitle"}}</h3>
    <dl class="arkhanval-about__credits-list">
      <div class="arkhanval-about__credit-row">
        <dt>{{localize "ARKHANVAL.About.Author"}}</dt>
        <dd><a href="{{authorUrl}}" target="_blank" rel="noopener noreferrer">Jean Marc Gilet</a></dd>
      </div>
      <div class="arkhanval-about__credit-row">
        <dt>{{localize "ARKHANVAL.About.Publisher"}}</dt>
        <dd><a href="{{publisherUrl}}" target="_blank" rel="noopener noreferrer">Storyline</a></dd>
      </div>
      <div class="arkhanval-about__credit-row">
        <dt>{{localize "ARKHANVAL.About.Developer"}}</dt>
        <dd><span class="arkhanval-about__developer-name">Evilbram</span></dd>
      </div>
    </dl>
  </section>

  <a class="arkhanval-about__github" href="{{repositoryUrl}}" target="_blank" rel="noopener noreferrer">
    <i class="fa-brands fa-github" aria-hidden="true"></i>
    <span>{{localize "ARKHANVAL.About.GitHub"}}</span>
    <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
  </a>

  <section class="arkhanval-about__support" aria-label="{{localize "ARKHANVAL.About.SupportTitle"}}">
    <h3>{{localize "ARKHANVAL.About.SupportTitle"}}</h3>
    <p>{{localize "ARKHANVAL.About.SupportText"}}</p>
    <a class="arkhanval-about__coffee" href="{{coffeeUrl}}" target="_blank" rel="noopener noreferrer">
      <i class="fa-solid fa-mug-hot" aria-hidden="true"></i>
      <span>{{localize "ARKHANVAL.About.Coffee"}}</span>
    </a>
  </section>
</div>
